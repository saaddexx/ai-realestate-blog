---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="AI for Real Estate Marketers">
  <section class="hero">
    <p class="eyebrow">For freelance real estate marketers</p>
    <h1>Practical AI workflows for residential real estate marketing</h1>
    <p class="intro">
      Learn how to use AI to research local topics, plan useful content, and
      organize your work—while checking sources and local facts before
      publishing.
    </p>
    <a class="button" href={`${base}/blog/`}>Explore the blog</a>
  </section>

  <section class="topics">
    <h2>What you’ll find here</h2>
    <div class="topic-grid">
      <article class="topic-card">
        <h3>Research local topics</h3>
        <p>
          Find useful questions and ideas for neighborhood pages, then check
          what the available evidence actually supports.
        </p>
      </article>

      <article class="topic-card">
        <h3>Plan better content</h3>
        <p>
          Turn research into clear briefs for pages that help homebuyers
          understand an area and find relevant listings.
        </p>
      </article>

      <article class="topic-card">
        <h3>Use AI with care</h3>
        <p>
          Separate AI suggestions from observed evidence, verify local claims,
          and keep a human in charge of publishing decisions.
        </p>
      </article>
    </div>
  </section>

  <section class="latest">
    <h2>Latest articles</h2>
    {
      posts.length === 0 ? (
        <p>New articles are on their way.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-card">
              <a class="post-title" href={`${base}/blog/${post.id}/`}>
                {post.data.title}
              </a>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
    <p><a href={`${base}/blog/`}>Browse all articles →</a></p>
  </section>

  <section class="approach">
    <h2>Useful guidance, clear evidence</h2>
    <p>
      AI can help organize research, but it cannot verify every local detail or
      prove what buyers are searching for. The articles here explain what was
      tried, link to relevant sources, and identify what still needs human
      review.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2.5rem 0 3rem;
  }

  .eyebrow {
    color: #9aa8b7;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .hero h1 {
    max-width: 20ch;
    margin-bottom: 1rem;
  }

  .intro {
    max-width: 68ch;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .button {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: #2678e8;
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .topics,
  .latest,
  .approach {
    margin: 2.5rem 0;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .topic-card,
  .post-card {
    padding: 1.25rem;
    border: 1px solid #30363d;
    border-radius: 0.75rem;
  }

  .topic-card h3 {
    margin-top: 0;
  }

  .topic-card p,
  .post-card p,
  .approach p {
    line-height: 1.7;
  }

  .post-list {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 700;
  }
</style>
